# =============================================================================
# AI-Powered Incident Intelligence Platform
# Environment Variables Template
# First Citizens Bank - Enterprise Deployment
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Replace placeholder values with actual credentials
#   3. NEVER commit .env to version control
# =============================================================================

# ── ServiceNow API Configuration ────────────────────────────────────────────
SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_USER=api_user
SERVICENOW_PASS=changeme

# ── Application Settings ────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Directory Paths ─────────────────────────────────────────────────────────
MODEL_DIR=models
DATA_DIR=data
FAISS_INDEX_DIR=indexes
# To use your own real CSV file instead of synthetic data, set the path below:
DATA_INPUT_PATH=data/raw/incidents.csv


# ── API Server Configuration ────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Dashboard Configuration ─────────────────────────────────────────────────
DASHBOARD_PORT=8501
