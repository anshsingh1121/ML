# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest and coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
pytest_cache/

# Data and Artifacts (Do not commit large data or trained models)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep
indexes/*
!indexes/.gitkeep
reports/*
!reports/.gitkeep

# Environment
.env
.venv
env/
venv/
ENV/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
